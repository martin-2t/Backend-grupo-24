doctype html
html(lang="es")
  head
    meta(charset="UTF-8")
    meta(name="viewport" content="width=device-width, initial-scale=1.0")
    title= titulo ? titulo + ' · Urbana Cult' : 'Urbana Cult'
    link(rel="preconnect" href="https://fonts.googleapis.com")
    link(href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap" rel="stylesheet")
    link(rel="stylesheet" href="/public/css/estilos.css")
  body
    header.top
      h1 Urbana Cult
      input#menu-toggle.menu-check(type="checkbox" aria-hidden="true")
      label.menu-boton(for="menu-toggle" aria-label="Abrir menú") ☰
      nav.main
        a(href="/panel") Inicio
        if usuario && usuario.rol === 'CLIENTE'
          a(href="/panel/eventos") Cartelera
        else
          a(href="/panel/eventos") Eventos
          if usuario && ['EMPLEADO', 'REPRESENTANTE'].includes(usuario.rol)
            a(href="/panel/salas") Mi centro
          else
            a(href="/panel/salas") Salas
        if usuario && usuario.rol !== 'CLIENTE'
          a(href="/panel/clientes") Clientes
          a(href="/panel/entradas") Entradas
          a(href="/panel/consultas") Consultas
        if usuario && ['ADMIN', 'REPRESENTANTE', 'AUDITOR'].includes(usuario.rol)
          a(href="/panel/usuarios") Usuarios
        if usuario && ['EMPLEADO', 'REPRESENTANTE'].includes(usuario.rol)
          a(href="/panel/checkin") Ingreso
        if usuario && usuario.rol === 'CLIENTE'
          a(href="/panel/mis-entradas") Mis entradas
        if usuario
          span #{usuario.nombre} (#{usuario.rol})
          form(method="POST" action="/panel/logout" style="display:inline")
            button.btn.secundario(type="submit") Salir
        else
          a(href="/panel/login") Ingresar
    main
      if mensaje
        .flash.ok= mensaje
      if alerta
        .flash.alerta= alerta
      block content

    script.
      //En pantallas chicas las tablas de listado se muestran como tarjetas
      document.querySelectorAll('table').forEach(function (t) {
        var ths = t.querySelectorAll('thead th');
        if (!ths.length) return;
        t.classList.add('apilada');
        t.querySelectorAll('tbody tr').forEach(function (tr) {
          Array.prototype.forEach.call(tr.children, function (td, i) {
            if (ths[i] && !td.hasAttribute('colspan')) {
              td.setAttribute('data-label', ths[i].textContent.trim());
            }
          });
        });
      });