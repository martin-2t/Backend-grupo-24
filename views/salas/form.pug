extends ../layout

//- Alta y edición en el mismo form
block content
  - var s = sala || {}
  - var esEdicion = Boolean(s.id)

  h2= esEdicion ? 'Editar sala' : 'Nueva sala'

  if error
    .error= error

  form.simple(method="POST" action=accion)
    label(for="nombre") Nombre
    input#nombre(type="text" name="nombre" value=s.nombre required minlength=largoMinimo pattern=patronLetras title='Solo letras, sin números ni símbolos. Mínimo ' + largoMinimo + ' caracteres')

    label(for="direccion") Dirección
    input#direccion(type="text" name="direccion" value=s.direccion required minlength=largoMinimo title='Mínimo ' + largoMinimo + ' caracteres')

    label(for="capacidad") Capacidad
    input#capacidad(type="number" name="capacidad" min=capacidadMinima step="1" value=s.capacidad required title='Número entero, mínimo ' + capacidadMinima + ' localidades')
    p.nota Mínimo #{capacidadMinima} localidades. Si la sala ya tiene lugares ocupados, tampoco se puede bajar por debajo de esa cantidad.

    .barra
      button.btn(type="submit" class=(esEdicion ? 'editar' : ''))= esEdicion ? 'Guardar cambios' : 'Crear sala'
      a.btn.secundario(href='/panel/salas') Volver

  if esEdicion
    p.nota El estado de la sala (activa / dada de baja) se cambia desde el listado o desde el detalle.
