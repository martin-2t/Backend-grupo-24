extends ../layout

block content
  h2 Usuarios

  if !soloLectura
    .barra
      a.btn(href="/panel/usuarios/nuevo") + Nuevo usuario

  form.filtros(method="GET" action="/panel/usuarios")
    if filtrosCompletos
      label(for="rol") Rol
      select#rol(name="rol")
        option(value="") Todos
        each r in roles
          option(value=r selected=(filtros.rol === r))= r
    label(for="estado") Estado
    select#estado(name="estado")
      option(value="") Todos
      each e in estados
        option(value=e selected=(filtros.estado === e))= e
    if filtrosCompletos
      label(for="salaId") Centro
      select#salaId(name="salaId")
        option(value="") Todos
        each sala in salas
          option(value=sala.id selected=(filtros.salaId === String(sala.id)))= sala.nombre
    button.btn.secundario(type="submit") Filtrar
    a.btn.secundario(href="/panel/usuarios") Limpiar

  table
    thead
      tr
        th #
        th Nombre
        th Email
        th Rol
        th Centro
        th Estado
        th Acciones
    tbody
      if usuarios.length === 0
        tr
          td.vacio(colspan="7") Todavía no hay usuarios cargados.
      each u, i in usuarios
        - var bloqueado = Boolean(u.bloqueadoHasta && u.bloqueadoHasta > new Date())
        tr
          td= i + 1
          td= u.nombre
          td= u.email
          td
            span.badge(class=u.rol)= u.rol
          td= u.salaId ? (nombreSala[String(u.salaId)] || 'Sala eliminada') : '—'
          td
            span.badge(class=u.estado)= u.estado
            if bloqueado
              span.badge  Bloqueado
          td.acciones
            if soloLectura
              span.vacio Solo lectura
            else if u.id !== usuario.id
              .grupo
                form.enlinea(method="POST" action="/panel/usuarios/" + u.id + "/estado" onsubmit="return confirm('¿Cambiar el estado de este usuario?')")
                  button.btn.chico(type="submit" class=(u.estado === 'ACTIVO' ? 'peligro' : 'editar'))= u.estado === 'ACTIVO' ? 'Suspender' : 'Activar'
                if bloqueado
                  form.enlinea(method="POST" action="/panel/usuarios/" + u.id + "/desbloquear")
                    button.btn.chico.secundario(type="submit") Desbloquear
            else
              span.vacio Tu cuenta

  p.nota Un usuario suspendido no puede ingresar ni operar, aunque tenga la sesión abierta.