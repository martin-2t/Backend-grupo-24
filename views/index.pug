extends layout

block content
  //- Panel general del personal, el ADMIN y el AUDITOR (el cliente tiene su propio inicio).
  //- operaBoleteria y gestionaEventos los define el middleware marcarPermisosDeVista
  - const esPersonal = usuario && usuario.rol !== 'CLIENTE'
  - const puedeVender = operaBoleteria
  h2 Panel general

  .cards
    a.card(href="/panel/eventos")
      div Eventos
      .num= totalEventos
    a.card(href="/panel/salas")
      div Salas
      .num= totalSalas
    if esPersonal
      a.card(href="/panel/clientes")
        div Clientes
        .num= totalClientes
      a.card(href="/panel/entradas?estado=VALIDA")
        div Entradas vendidas
        .num= entradasVendidas
      a.card(href="/panel/entradas?estado=RESERVADA")
        div Reservas activas
        .num= entradasReservadas

  if esPersonal
    .barra
      if puedeVender
        a.btn(href="/panel/entradas/nueva") Vender entrada
      if gestionaEventos
        a.btn(href="/panel/eventos/nuevo") + Nuevo evento
      a.btn.secundario(href="/panel/consultas") Ver consultas

  h2 Próximos eventos
  if proximos.length === 0
    p.vacio No hay eventos próximos programados.
  else
    table
      thead
        tr
          th Evento
          th Fecha
          th Precio
          if puedeVender
            th
      tbody
        each evento in proximos
          tr
            td
              a(href="/panel/eventos/" + evento.id)= evento.nombre
            td= new Date(evento.fecha).toLocaleString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', hourCycle: 'h23' })
            td= '$' + evento.precio
            if puedeVender
              td.acciones
                a.btn.chico(href="/panel/entradas/nueva?evento=" + evento.id) Vender