extends ../layout

block content
  - const rol = usuario ? usuario.rol : null
  //- gestionaEventos, operaBoleteria y esNegocio los define el middleware marcarPermisosDeVista.
  //- El personal opera solo sobre la sala donde trabaja. El ADMIN no gestiona eventos ni vende,
  //- pero puede cancelar un evento por fuerza mayor
  - const esMiSala = String(evento.salaId) === String(usuario.salaId)
  - const puedeGestionar = gestionaEventos && esMiSala
  - const puedeCancelar = puedeGestionar || rol === 'ADMIN'
  - const puedeOperar = operaBoleteria && esMiSala

  //- aArrastrar lo calcula el controller: la regla de qué entradas se arrastran es del model
  - var avisoCancelar = '¿Cancelar este evento?'
  if aArrastrar === 1
    - avisoCancelar = '¿Cancelar este evento? También se va a cancelar su entrada vendida o reservada.'
  else if aArrastrar > 1
    - avisoCancelar = '¿Cancelar este evento? También se van a cancelar sus ' + aArrastrar + ' entradas vendidas o reservadas.'

  .encabezado
    div
      h2= evento.nombre
      p.subtitulo
        if rol !== 'CLIENTE'
          span.badge(class=evento.estado)= evento.estado
          if yaPaso && evento.estado === 'PROGRAMADO'
            span.badge.PASADO Ya pasó, sin finalizar
          span  · 
        span #{evento.sala} · #{new Date(evento.fecha).toLocaleString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', hourCycle: 'h23' })}
    .acciones
      if puedeGestionar
        a.btn.editar(href="/panel/eventos/" + evento.id + "/editar") Editar
      if evento.estado === 'PROGRAMADO'
        if puedeOperar && evento.disponibles > 0
          a.btn(href="/panel/entradas/nueva?evento=" + evento.id) Vender entrada
        if puedeGestionar
          form.enlinea(method="POST" action="/panel/eventos/" + evento.id + "/finalizar" onsubmit="return confirm('¿Finalizar este evento? No va a admitir más ventas.')")
            button.btn.baja(type="submit") Finalizar
      if puedeCancelar && evento.estado !== 'CANCELADO'
        form.enlinea(method="POST" action="/panel/eventos/" + evento.id + "/cancelar" onsubmit="return confirm('" + avisoCancelar + "')")
          button.btn.baja(type="submit") Cancelar evento

  //- El cliente no ve los números de gestión (capacidad y ocupación): solo el precio.
  //- La disponibilidad le llega en el bloque de compra ("hasta N entradas" o "Agotado")
  .cards
    if rol !== 'CLIENTE'
      .card
        div Capacidad de sala
        .num= evento.capacidad
      .card
        div Lugares ocupados
        .num= evento.ocupados
      .card
        div Disponibles
        .num= evento.disponibles
    .card
      div Precio
      .num= '$' + evento.precio

  if evento.descripcion
    .panel-dato
      h3 Descripción
      p= evento.descripcion

  //- Compra web: solo el CLIENTE. "compra" lo arma el controller (cuántas puede o por qué no)
  if compra
    .panel-dato.compra-evento
      h3 Comprar entradas
      if compra.maximo
        form.compra-form(method="POST" action="/panel/compras")
          input(type="hidden" name="eventoId" value=evento.id)
          label(for="cantidad") Cantidad
          select#cantidad(name="cantidad")
            - for (var n = 1; n <= compra.maximo; n++)
              option(value=n)= n
          button.btn(type="submit") Comprar
        p.nota= 'Hasta ' + compra.maximo + ' entradas por compra, a $' + evento.precio + ' cada una. Al continuar te guardamos los lugares unos minutos mientras pagás.'
      else
        p.compra-cerrada= compra.motivo

  //- Las entradas muestran el nombre de cada comprador: las ve el personal de este centro y el
  //- negocio (ADMIN y AUDITOR), que solo consulta
  if puedeOperar || esNegocio
    h3 Entradas de este evento
    if entradas.length === 0
      p.vacio Todavía no se vendieron ni reservaron entradas para este evento.
    else
      table
        thead
          tr
            th #
            th Cliente
            th Precio
            th Estado
            th Acciones
        tbody
          each entrada in entradas
            tr
              td= entrada.id
              td= entrada.cliente
              td= '$' + entrada.precio
              td
                span.badge(class=entrada.estado)= entrada.estado
              td.acciones
                .grupo
                  a.btn.chico.secundario(href="/panel/entradas/" + entrada.id) Ver
                  if puedeOperar && entrada.estado === 'RESERVADA'
                    form.enlinea(method="POST" action="/panel/entradas/" + entrada.id + "/confirmar")
                      button.btn.chico(type="submit") Confirmar
                  if puedeOperar && (entrada.estado === 'VALIDA' || entrada.estado === 'RESERVADA')
                    form.enlinea(method="POST" action="/panel/entradas/" + entrada.id + "/cancelar" onsubmit="return confirm('¿Cancelar esta entrada? El lugar quedará liberado.')")
                      button.btn.chico.baja(type="submit") Cancelar

  p.volver
    a(href="/panel/eventos")= rol === 'CLIENTE' ? '← Volver a la cartelera' : '← Volver a eventos'