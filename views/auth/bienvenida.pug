extends ../layout

block content
  .encabezado
    div
      h2 Hola, #{usuario.nombre}
      p.subtitulo
        span.badge(class=usuario.rol)= usuario.rol
        if sala
          span  · Centro: #{sala.nombre}

  .panel-dato
    h3 Con tu rol podés:
    ul
      each permiso in permisos
        li= permiso

  .panel-dato
    h3 Tu sesión
    p
      | Iniciaste sesión con un token JWT guardado en una cookie segura. La sesión dura 2 horas
      | y se cierra con el botón "Salir".

  .barra
    a.btn(href="/panel") Ir al panel