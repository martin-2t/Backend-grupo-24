extends ../layout

block content
  .encabezado
    div
      h2= 'Entrada #' + entrada.id
      p.subtitulo
        span.badge(class=entrada.estado)= entrada.estado
    if !soloLectura
      .acciones
        if entrada.estado === 'RESERVADA'
          form.enlinea(method="POST" action="/panel/entradas/" + entrada.id + "/confirmar")
            button.btn(type="submit") Confirmar reserva
        if entrada.estado === 'VALIDA' || entrada.estado === 'RESERVADA'
          form.enlinea(method="POST" action="/panel/entradas/" + entrada.id + "/cancelar" onsubmit="return confirm('¿Cancelar esta entrada? El lugar quedará liberado.')")
            button.btn.baja(type="submit") Cancelar

  table
    tbody
      tr
        th Evento
        td
          if evento
            a(href="/panel/eventos/" + evento.id)= evento.nombre
            span  · #{new Date(evento.fecha).toLocaleString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', hourCycle: 'h23' })} · #{evento.sala}
          else
            span= entrada.evento
      tr
        th Cliente
        td
          if cliente
            a(href="/panel/clientes/" + cliente.id)= cliente.nombre + ' ' + cliente.apellido
            span  · #{cliente.email}
          else
            span= entrada.cliente
      tr
        th Precio
        td= '$' + entrada.precio
      tr
        th Estado
        td
          span.badge(class=entrada.estado)= entrada.estado
      if entrada.estado === 'RESERVADA' && entrada.venceEn
        tr
          th Vencimiento
          td= 'Si no se confirma el pago, la reserva vence a las ' + new Date(entrada.venceEn).toLocaleTimeString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', hour: '2-digit', minute: '2-digit', hourCycle: 'h23' }) + ' y libera el lugar.'
      if entrada.usadaEn
        tr
          th Ingreso
          td= 'Ingresó el ' + new Date(entrada.usadaEn).toLocaleString('es-AR', { timeZone: 'America/Argentina/Buenos_Aires', hourCycle: 'h23' }) + (validador ? ' · validada por ' + validador : '')

  if qr
    h3 Código QR de ingreso
    .qr-ingreso
      img(src=qr alt="Código QR de la entrada " + entrada.codigo width="240" height="240")
      div
        p En la puerta, el personal del centro escanea este código con el celular y valida el ingreso.
        p
          | Código:
          code.codigo= entrada.codigo
        //- Abre la misma URL que el QR, con los mismos permisos: solo ahorra el paso del celular
        if puedeValidar && entrada.estado === 'VALIDA'
          a.btn.secundario(href="/panel/checkin/" + entrada.codigo) Simular lectura del QR

  if !soloLectura
    h3 Corregir precio
    form.simple(method="POST" action="/panel/entradas/" + entrada.id + "/precio")
      label(for="precio") Precio
      input#precio(type="number" name="precio" min="0" step="1" value=entrada.precio required)
      .barra
        button.btn.editar(type="submit") Guardar precio

    h3 Eliminar
    p.nota Eliminar borra el registro físicamente. Para liberar el lugar conservando el historial, usá Cancelar.
    form.enlinea(method="POST" action="/panel/entradas/" + entrada.id + "/eliminar" onsubmit="return confirm('¿Eliminar definitivamente esta entrada?')")
      button.btn.peligro(type="submit") Eliminar entrada

  p.volver
    a(href="/panel/entradas") ← Volver a entradas
