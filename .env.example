# Copiar este archivo como .env (que NO se sube al repo) y completar.

# MongoDB local (por ejemplo, con Docker):
MONGODB_URI=mongodb://127.0.0.1:27017/urbana-cult

# MongoDB Atlas: reemplazar por la cadena que da Atlas en "Connect > Drivers".
# Para desarrollar, cada integrante usa su propia base (por ejemplo, urbana-cult-martin);
# urbana-cult es la base compartida del equipo.
# MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/urbana-cult

PORT=3000
