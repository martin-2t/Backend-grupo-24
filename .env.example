# Copiar este archivo como .env (que NO se sube al repo) y completar.

# MongoDB local (por ejemplo, con Docker):
#MONGODB_URI=mongodb://127.0.0.1:27017/urbana-cult

# MongoDB Atlas: reemplazar por la cadena que da Atlas en "Connect > Drivers".
# Para desarrollar, cada integrante usa su propia base (por ejemplo, urbana-cult-martin);
# urbana-cult es la base compartida del equipo.
# MONGODB_URI=mongodb+srv://USUARIO:CLAVE@CLUSTER.mongodb.net/urbana-cult

# Obligatoria: clave con la que se firma el token de sesion (JWT). Usar un texto largo y aleatorio,
# por ejemplo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Cuánto dura la sesión (2h si no se define). Ejemplos: 30m, 2h, 1d
#JWT_EXPIRES_IN=2h

#PORT=3000

# Minutos que se retienen los lugares mientras un cliente paga una compra web (10 si no se define)
#RETENCION_MINUTOS=10

# Asistente de cartelera (opcional): sin la clave, el chat responde 503 y el resto de la app funciona igual.
# La clave se obtiene en Google AI Studio.
#GEMINI_API_KEY=
# Modelo de Gemini a usar (gemini-3.5-flash-lite si no se define)
#GEMINI_MODEL=gemini-3.5-flash-lite
