{
  "name": "urbana-cult-eventos",
  "version": "1.0.0",
  "description": "API REST para el sistema de eventos y entradas de Urbana Cult",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "seed": "node scripts/seed.js",
