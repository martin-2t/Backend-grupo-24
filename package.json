    "connect-flash": "^0.1.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^18.0.7",
    "express": "^4.22.2",
    "express-session": "^1.19.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.2",
    "mongoose-unique-validator": "^6.1.1",
    "passport": "^0.7.0",
    "passport-local": "^1.0.0",
    "pug": "^3.0.4",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "jest": "^30.5.2",
    "mongodb-memory-server": "^11.3.0",
    "nodemon": "^3.1.11",
    "supertest": "^7.3.2"
  }
